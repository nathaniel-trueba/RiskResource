# Copy to backend/.env and fill in DATABASE_URL. Everything else is optional.
# (Named env.example because .gitignore excludes .env files.)

# Required. Supabase dashboard > Connect > "Session pooler" connection string.
# Replace [YOUR-PASSWORD] with the database password, URL-encoded if it has
# special characters (e.g. @ becomes %40). The backend only needs this; no
# Supabase API keys are used.
DATABASE_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres

USER_AGENT=UCSD-Risk-Resource-NotForProfit
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
UPSTREAM_TIMEOUT_SECONDS=15

# Cache lifetimes, in seconds
FEEDS_TTL_SECONDS=300
SNAPSHOT_TTL_SECONDS=60
WEATHER_TTL_SECONDS=1800
GAUGES_TTL_SECONDS=900
GEOCODE_TTL_SECONDS=86400

# Where the weekly wildfire job publishes its county probabilities: a path (relative
# to backend/) or s3://bucket/key. The job reads the same variable. And how many days
# after its Monday a week's scores still count.
# WILDFIRE_MODEL_URI=data/wildfire_model.json
# WILDFIRE_MODEL_URI=s3://my-bucket/wildfire/latest.json   # After the AWS migration; needs boto3
# WILDFIRE_MODEL_MAX_AGE_DAYS=13

# When NWS is unreachable, use the Lambda's alert archive if its last run is at most
# this many minutes old. 90 suits hourly runs; 30 suits every 15 minutes.
# ALERT_ARCHIVE_MAX_AGE_MINUTES=90
